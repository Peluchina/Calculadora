@{
    ViewData["Title"] = "Home Page";
}

<form>
    <div class="form-check">
      <input class="form-check-input" type="radio" name="exampleRadios" id="exampleRadios1" value="option1" checked>
      <label class="form-check-label" for="exampleRadios1">
        Calculadora Inversa
      </label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="radio" name="exampleRadios" id="exampleRadios2" value="option2">
      <label class="form-check-label" for="exampleRadios2">
        Calculadora Normal
      </label>
    </div>
    <br />
    <div class="mb-3">
        <label for="exampleInputEmail1" class="form-label">Primer numero</label>
        <input type="number" class="form-control" id="primerNumero" aria-describedby="emailHelp">
        <div id="emailHelp" class="form-text">Ingrese primer numero a calcular.</div>
    </div>
    <div class="mb-3">
        <label for="exampleInputEmail1" class="form-label">Segundo numero</label>
        <input type="number" class="form-control" id="segundoNumero" aria-describedby="emailHelp">
        <div id="emailHelp" class="form-text">Ingrese segundo numero a calcular.</div>
    </div>
    <div class="col-md-2">
        <label for="cboEventoHora">Tipo de operación</label>
        <select id="cboEventoHora" class="form-control">
            <option value="0" selected>Seleccionar operación</option>>
            <option value="1">Suma</option>
            <option value="2">Resta</option>
            <option value="3">Multiplicación</option>
            <option value="4">División</option>
        </select>
    </div>
    <br />
    <button type="button" class="btn btn-primary" id="btnCalcular">Calcular</button>
    <div class="mb-3">
        <label for="exampleInputEmail1" class="form-label">Resultado</label>
        <input type="number" class="form-control" id="resultado" aria-describedby="emailHelp" readonly>
    </div>
</form>
<hr />
<h1>Historial</h1>

<br />
<div class="row mb-3 mt-2">
    <div class="col-md-12">
        <div class="dt-container">
            <table id="tablaRecibo" class="stripe row-border order-column nowrap" style="width:100%">
                <thead>
                    <tr>
                        <th width="120px;">N°</th>
                        <th width="120px;">Primer numero</th>
                        <th width="120px;">Segundo numero</th>
                        <th width="140px;">Operador</th>
                        <th width="200px;">Resultado</th>
                        <th>Observación</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" />
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script>

        $(document).ready(function () {
            iniTable();

            $("#btnCalcular").click(function (e) {
                e.preventDefault();

                let tipo = obtenerTipoCalculadora();

                if (tipo === "option1") {
                    calcularInversa();
                } else {
                    calcularNormal();
                }
            });


       });

        function obtenerTipoCalculadora() {
            return $("input[name='exampleRadios']:checked").val();
        }


        //Funciones

        function obtenerDatos() {
            return {
                NumeroUno: parseInt($('#primerNumero').val()),
                NumeroDos: parseInt($('#segundoNumero').val()),
                IdOperador: parseInt($('#cboEventoHora').val())
            };
        }

        function validarDatos(datos) {
            if (isNaN(datos.NumeroUno)) 
            {
                Swal.fire({
                    icon: 'warning',
                    title: 'Ingresa el primer numero para realizar el calculo'
                });
                return false;
            }
            else if(isNaN(datos.NumeroDos)) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Ingresa el segundo numero para realizar el calculo'
                });
                return false;
            }
            else if (isNaN(datos.IdOperador)||(datos.IdOperador==0)){
                Swal.fire({
                    icon: 'warning',
                    title: 'Ingresa el operador para realizar el calculo'
                });
                return false;
            }
            return true;

        }

        function llamarAPINormal(json) {

            $("#btnCalcular").attr("disabled", true);

            $.ajax({
                type: 'POST',
                url: `/api/Operacion/InsertarOpC`,
                contentType: 'application/json',
                data: JSON.stringify(json),

                success: function (resultado) {

                    if (resultado && resultado.resultadoCalculado !== undefined) {
                        $('#resultado').val(resultado.resultadoCalculado);
                    }

                    Swal.fire({
                        icon: 'success',
                        title: 'Operación realizada correctamente'
                    });

                    if (typeof tabla !== 'undefined') {
                        tabla.ajax.reload(null, false);
                    }
                },

                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error en la operación'
                    });
                },

                complete: function () {
                    $("#btnCalcular").attr("disabled", false);
                }
            });
        }


        function llamarAPIinversa(json) {

            $("#btnCalcular").attr("disabled", true);

            $.ajax({
                type: 'POST',
                url: `/api/Operacion`,
                contentType: 'application/json',
                data: JSON.stringify(json),

                success: function (resultado) {

                    if (resultado && resultado.resultadoCalculado !== undefined) {
                        $('#resultado').val(resultado.resultadoCalculado);
                    }

                    Swal.fire({
                        icon: 'success',
                        title: 'Operación realizada correctamente'
                    });

                    if (typeof tabla !== 'undefined') {
                        tabla.ajax.reload(null, false);
                    }
                },

                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error en la operación'
                    });
                },

                complete: function () {
                    $("#btnCalcular").attr("disabled", false);
                }
            });
        }



        function calcularInversa() {

            let datos = obtenerDatos();

            if (!validarDatos(datos)) return;
            llamarAPIinversa(datos);
        }


        function calcularNormal() {

            let datos = obtenerDatos();

            if (!validarDatos(datos)) return;

            llamarAPINormal(datos);
        }


        //Listado
         var tabla;
        function iniTable() {
            tabla = $('#tablaRecibo').DataTable({
                fixedColumns: {
                    start: 1,
                    end: 1
                },
                responsive: true,
                scrollX: true,
                scrollCollapse: true,
                scrollY: '50vh',
                paging: true,
                pageLength: 10,
                ajax: {
                    url: `/api/Operacion`,
                    type: 'GET',
                    dataSrc: 'data'

                },
                columns: [
                    {
                        data: 'idOperacion',
                        visible: false
                    },
                    { data: 'numeroUno' },
                    { data: 'numeroDos' },
                    { data: 'nomOperador' },
                    { data: 'resultado' },
                    { data: 'mensaje' }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/es-ES.json',
                    emptyTable: 'No hay información disponible.'
                },
            });
        }
        
       
    </script>
}